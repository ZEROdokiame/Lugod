<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hospital.mapper.QueueInfoMapper">

    <resultMap type="com.ruoyi.hospital.domain.QueueInfo" id="QueueInfoResult">
        <id property="queueId" column="queue_id"/>
        <result property="queueName" column="queue_name"/>
        <result property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="currentNumber" column="current_number"/>
        <result property="maxNumber" column="max_number"/>
        <result property="queueNumber" column="queue_number"/>
        <result property="status" column="status"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectQueueInfoVo">
        select q.queue_id, q.queue_name, q.dept_id, q.dept_name,
        q.current_number, q.max_number, q.queue_number, q.status,
        q.start_time, q.end_time, q.create_by, q.create_time,
        q.update_by, q.update_time, q.remark
        from hospital_queue_info q
    </sql>

    <select id="selectQueueList" parameterType="com.ruoyi.hospital.domain.QueueInfo" resultMap="QueueInfoResult">
        <include refid="selectQueueInfoVo"/>
        <where>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="queueNumber != null and queueNumber != ''">
                AND queue_number = #{queueNumber}
            </if>
        </where>
        order by queue_number asc
    </select>

    <insert id="insertQueueInfo" parameterType="com.ruoyi.hospital.domain.QueueInfo" useGeneratedKeys="true" keyProperty="queueId">
        insert into hospital_queue_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="queueName != null">queue_name,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="deptName != null">dept_name,</if>
            <if test="currentNumber != null">current_number,</if>
            <if test="maxNumber != null">max_number,</if>
            <if test="queueNumber != null">queue_number,</if>
            <if test="status != null">status,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="queueName != null">#{queueName},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="deptName != null">#{deptName},</if>
            <if test="currentNumber != null">#{currentNumber},</if>
            <if test="maxNumber != null">#{maxNumber},</if>
            <if test="queueNumber != null">#{queueNumber},</if>
            <if test="status != null">#{status},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateQueueInfo" parameterType="com.ruoyi.hospital.domain.QueueInfo">
        update hospital_queue_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="queueName != null">queue_name = #{queueName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="deptName != null">dept_name = #{deptName},</if>
            <if test="currentNumber != null">current_number = #{currentNumber},</if>
            <if test="maxNumber != null">max_number = #{maxNumber},</if>
            <if test="queueNumber != null">queue_number = #{queueNumber},</if>
            <if test="status != null">status = #{status},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where queue_id = #{queueId}
    </update>

    <delete id="deleteQueueInfoById" parameterType="Long">
        delete from hospital_queue_info where queue_id = #{queueId}
    </delete>

    <delete id="deleteQueueInfoByIds" parameterType="String">
        delete from hospital_queue_info where queue_id in
        <foreach item="queueId" collection="array" open="(" separator="," close=")">
            #{queueId}
        </foreach>
    </delete>

    <!-- 查询单个队列信息 -->
    <select id="selectQueueById" parameterType="Long" resultMap="QueueInfoResult">
        <include refid="selectQueueInfoVo"/>
        where queue_id = #{queueId}
    </select>
</mapper>
