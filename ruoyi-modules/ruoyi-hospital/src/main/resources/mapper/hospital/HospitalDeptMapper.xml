<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hospital.mapper.HospitalDeptMapper">

    <resultMap type="com.ruoyi.hospital.domain.HospitalDept" id="HospitalDeptResult">
        <id property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="orderNum" column="order_num"/>
        <result property="leader" column="leader"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectHospitalDeptVo">
        select dept_id, dept_name, order_num, leader, phone, email, status, create_by, create_time, update_by, update_time, remark
        from hospital_dept
    </sql>

    <select id="selectHospitalDeptList" parameterType="com.ruoyi.hospital.domain.HospitalDept" resultMap="HospitalDeptResult">
        <include refid="selectHospitalDeptVo"/>
        <where>
            <if test="deptName != null and deptName != ''">
                AND dept_name like concat('%', #{deptName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by order_num
    </select>

    <select id="selectHospitalDeptAll" resultMap="HospitalDeptResult">
        <include refid="selectHospitalDeptVo"/>
        where status = '0'
        order by order_num
    </select>

    <select id="selectHospitalDeptById" parameterType="Long" resultMap="HospitalDeptResult">
        <include refid="selectHospitalDeptVo"/>
        where dept_id = #{deptId}
    </select>

    <insert id="insertHospitalDept" parameterType="com.ruoyi.hospital.domain.HospitalDept">
        insert into hospital_dept(
            <if test="deptName != null and deptName != ''">dept_name,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="leader != null">leader,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        )values(
            <if test="deptName != null and deptName != ''">#{deptName},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="leader != null">#{leader},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateHospitalDept" parameterType="com.ruoyi.hospital.domain.HospitalDept">
        update hospital_dept
        <set>
            <if test="deptName != null and deptName != ''">dept_name = #{deptName},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="leader != null">leader = #{leader},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where dept_id = #{deptId}
    </update>

    <delete id="deleteHospitalDeptById" parameterType="Long">
        delete from hospital_dept where dept_id = #{deptId}
    </delete>

    <delete id="deleteHospitalDeptByIds" parameterType="String">
        delete from hospital_dept where dept_id in
        <foreach item="deptId" collection="array" open="(" separator="," close=")">
            #{deptId}
        </foreach>
    </delete>
</mapper>
